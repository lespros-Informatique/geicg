# Configuration Environnement GEICG (Modèle à copier vers .env)
APP_NAME=GEICG
APP_ENV=developpement
APP_URL=http://localhost/geicg/
APP_TIMEZONE=Africa/Abidjan

# Accès MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_eicg
DB_USER=root
DB_PASSWORD=

# ---- SERVICES EMAIL (PHPMailer / SMTP) ----
MAIL_MAILER=smtp
MAIL_HOST=mail.votre-domaine.com
MAIL_PORT=465
MAIL_USERNAME=noreply@votre-domaine.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@votre-domaine.com
MAIL_FROM_NAME="GROUPE EICG"

# ---- NOTIFICATIONS PUSH (OneSignal) ----
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ---- AUTHENTIFICATION GOOGLE OAUTH ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/geicg/auth/google/callback

# ---- PDF GENERATION (mPDF / Dompdf) ----
DOMPDF_PAPER_SIZE=A4
DOMPDF_ORIENTATION=portrait
